{
  "expo": {
    "name": "Word7000",
    "slug": "word7000",
    "owner": "rio10255254",
    "scheme": "word7000",
    "version": "1.4.1",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "description": "A simple offline 7000-word English vocabulary app for daily learning and review.",
    "ios": {
      "bundleIdentifier": "com.rio.word7000",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "usesAppleSignIn": true,
      "supportsTablet": false
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#2563EB",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "experiments": {
      "typedRoutes": true
    },
    "plugins": [
      "expo-apple-authentication",
      "expo-web-browser",
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#2563EB",
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-widgets",
        {
          "enablePushNotifications": true
        }
      ],
      "expo-status-bar",
      [
        "expo-image-picker",
        {
          "photosPermission": "Word7000 需要讀取你選的照片，在手機上辨識單字表裡的英文與中文意思。照片不會上傳。",
          "cameraPermission": "Word7000 需要使用相機拍下單字表，在手機上辨識英文與中文意思。照片不會上傳。",
          "microphonePermission": false
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "d973eb82-7066-453c-a361-afe987ba0ca1"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/d973eb82-7066-453c-a361-afe987ba0ca1"
    }
  }
}
