{
  "expo": {
    "name": "Word7000",
    "slug": "word7000",
    "owner": "rio10255254",
    "scheme": "word7000",
    "version": "1.2.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "description": "A simple offline 7000-word English vocabulary app for daily learning and review.",
    "ios": {
      "bundleIdentifier": "com.rio.word7000",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "usesAppleSignIn": true,
      "supportsTablet": false
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "experiments": {
      "typedRoutes": true
    },
    "plugins": [
      "expo-apple-authentication",
      "expo-web-browser",
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#2d64e7",
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "d973eb82-7066-453c-a361-afe987ba0ca1"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/d973eb82-7066-453c-a361-afe987ba0ca1"
    }
  }
}
