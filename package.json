{
  "name": "word7000-app",
  "version": "1.5.0",
  "dependencies": {
    "pinyin-pro": "^3.28.1"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@peculiar/x509": "^1.12.3",
    "@types/node": "^26.0.1",
    "csv-parse": "^7.0.0",
    "opencc-js": "^1.3.1",
    "playwright": "^1.61.1",
    "typescript": "~6.0.3",
    "vitest": "^4.1.9",
    "xcode": "^3.0.1"
  },
  "scripts": {
    "audit:examples": "node scripts/audit-example-quality.mjs",
    "audit:examples:zh-tw": "node scripts/audit-taiwan-chinese-examples.mjs",
    "audit:meanings": "node scripts/audit-meaning-quality.mjs",
    "build:web": "node scripts/check-static-site.mjs",
    "validate:meanings": "node scripts/validate-reviewed-meanings.mjs",
    "generate:words": "node scripts/generate-word-data.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "verify": "npm test && npm run audit:examples && npm run audit:examples:zh-tw && npm run validate:meanings && npm run audit:meanings && npm run typecheck && npm run build:web"
  },
  "private": true,
  "overrides": {
    "nanoid": "3.3.18"
  }
