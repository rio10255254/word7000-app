{
  "name": "word7000-promo",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "studio": "remotion studio",
    "render": "remotion render Full out/word7000-full-60fps.mp4",
    "still": "remotion still Full out/still.png",
    "typecheck": "tsc --noEmit",
    "music": "python3 scripts/make-music.py",
    "voice": ".venv-voice/bin/python scripts/make-voice.py",
    "reels": "python3 scripts/make-reels.py",
    "render:reels": "for e in ep01 ep02 ep03; do remotion render Reel-$e out/reel-$e.mp4; done"
  },
  "dependencies": {
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/noto-sans-tc": "^5.3.1",
    "@fontsource/noto-serif": "^5.3.0",
    "@fontsource/noto-serif-tc": "^5.3.1",
    "@react-three/drei": "10.7.6",
    "@react-three/fiber": "9.4.0",
    "@remotion/cli": "^4.0.539",
    "@remotion/three": "4.0.539",
    "@remotion/transitions": "^4.0.539",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "remotion": "^4.0.539",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "@types/three": "0.180.0",
    "typescript": "~6.0.3"
  }
}
