/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

/index.html
  Cache-Control: no-cache

/manifest.json
  Cache-Control: no-cache

/service-worker.js
  Cache-Control: no-cache

/version.json
  Cache-Control: no-cache

/ios-update.json
  Cache-Control: no-store

/auth-native.html
  Cache-Control: no-store
  Referrer-Policy: no-referrer

/assets/*
  Cache-Control: public, max-age=31536000, immutable
