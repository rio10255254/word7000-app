// The web app is gone. This Worker now only serves the static files in
// public/ that the native iOS app links to or fetches:
//   /auth-native.html  sign-in return page (AccountModel.redirectURL)
//   /privacy.html      privacy policy (Me, paywall, App Store listing)
//   /support.html      support page (Me, App Store listing)
//   /ai-features.json  remote switch for the AI features (IntelligenceSettings)
//   /ios-update.json   update prompt read by old React Native builds
// No build step is needed: deploy with `npx wrangler deploy`.
{
  "name": "word7000-app",
  "compatibility_date": "2026-06-30",
  "assets": {
    "directory": "./public",
    "not_found_handling": "none"
  },
  "observability": {
    "enabled": true
  }
}
